{
  "name": "@oh-my-dsh/stent-dsh",
  "description": "DSH integrations for the Cordis Stent layer: DSH-facing facades, the package invariant, and the DSH profile bootstrap that composes the pure stent hooks",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host/agent": {
      "types": "./lib/host/agent.d.ts",
      "default": "./lib/host/agent.js"
    },
    "./host/tools": {
      "types": "./lib/host/tools.d.ts",
      "default": "./lib/host/tools.js"
    },
    "./host/prompt": {
      "types": "./lib/host/prompt.d.ts",
      "default": "./lib/host/prompt.js"
    },
    "./host/commands": {
      "types": "./lib/host/commands.d.ts",
      "default": "./lib/host/commands.js"
    },
    "./bootstrap/profile": {
      "types": "./lib/bootstrap/profile.d.ts",
      "default": "./lib/bootstrap/profile.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./browser/client": {
      "types": "./lib/browser/client.d.ts",
      "default": "./lib/browser/client.js"
    },
    "./client": {
      "types": "./lib/browser/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/host/*.js",
    "lib/bootstrap/*.js",
    "lib/browser/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/stent.git"
  },
  "scripts": {
    "build": "pnpm --filter @oh-my-dsh/stent run build && tsdown --config-loader unrun --config tsdown.config.ts",
    "fmt": "oxfmt --config ../../.oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config ../../.oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix src tests",
    "knip": "knip --config knip.json --treat-config-hints-as-errors",
    "test": "pnpm run build && vitest run --config vitest.config.ts"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0",
    "@oh-my-dsh/stent": "^0.1.0",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0",
    "@types/node": "^22.20.0",
    "@oh-my-dsh/stent": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "happy-dom": "^20.0.0",
    "knip": "^6.16.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
