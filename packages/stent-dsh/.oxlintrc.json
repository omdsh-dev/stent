{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.base.json"
  ],
  "ignorePatterns": [
    "tests/fixtures/**",
    "**/*.mjs"
  ],
  "rules": {
    "node/no-top-level-await": "off", // Restriction
    "eslint/class-methods-use-this": "off", // Restriction
    "typescript/no-explicit-any": "off" // Restriction
  }
}
