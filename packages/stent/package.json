{
  "name": "@oh-my-dsh/stent",
  "description": "Stent/Mixin-style extension layer over Orchestrion for trusted Cordis plugins",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "default": "./lib/node.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "./activation": {
      "types": "./lib/activation.d.ts",
      "default": "./lib/activation.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/browser/client.d.ts",
      "default": "./lib/client.js"
    },
    "./hmr/ownership": {
      "types": "./lib/hmr/ownership.d.ts",
      "default": "./lib/hmr/ownership.js"
    },
    "./hmr/reload": {
      "types": "./lib/hmr/reload.d.ts",
      "default": "./lib/hmr/reload.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/node/*.js",
    "lib/browser/*.js",
    "lib/transform/*.js",
    "lib/hmr/*.js",
    "lib/testing/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/stent.git"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "fmt": "oxfmt --config ../../.oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config ../../.oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix src tests",
    "knip": "knip --config knip.json --treat-config-hints-as-errors",
    "test": "pnpm run build && vitest run --config vitest.config.ts"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0"
  },
  "dependencies": {
    "@apm-js-collab/code-transformer": "^0.18.1",
    "node-addon-require-builtin": "^0.1.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.20.0",
    "knip": "^6.16.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
