{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@oh-my-dsh/stent-api",
        "@oh-my-dsh/stent-dsh"
      ]
    },
    "packages/stent": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "stent-target-fixture"
      ]
    },
    "packages/stent-api": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "stent-compat-target"
      ]
    },
    "packages/stent-dsh": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "stent-api-fixture-mod"
      ]
    }
  }
}
