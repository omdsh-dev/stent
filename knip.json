{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "packages/**"
      ],
      "ignoreDependencies": [
        "@oh-my-dsh/stent-api",
        "@oh-my-dsh/stent-dsh"
      ]
    }
  }
}
