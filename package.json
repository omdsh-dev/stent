{
  "name": "@oh-my-dsh/stent-pack",
  "description": "Stent/Mixin extension workspace: installable profile bundle carrier over the stent package trio",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/stent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/stent-dsh.js",
    "lib/stent-dsh.js.map",
    "lib/stent-dsh-preload.js",
    "lib/stent-dsh-preload.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @oh-my-dsh/stent run build && pnpm --filter @oh-my-dsh/stent-api run build && pnpm --filter @oh-my-dsh/stent-dsh run build && pnpm exec tsdown --config-loader unrun --config tsdown.config.ts",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings .",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix .",
    "knip": "knip --treat-config-hints-as-errors",
    "typecheck": "tsc -p tsconfig.vitest.json --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@oh-my-dsh/stent": "^0.1.1",
    "@oh-my-dsh/stent-api": "^0.1.1",
    "@oh-my-dsh/stent-dsh": "^0.1.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "happy-dom": "^20.0.0",
    "knip": "^6.16.1",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  },
  "bin": {
    "stent-dsh": "lib/stent-dsh.js"
  }
}
