{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "packages/*/tests/fixtures/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts"
  ]
}
