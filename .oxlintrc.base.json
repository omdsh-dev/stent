{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error"
  },
  "plugins": [
    "import",
    "typescript",
    "node",
    "unicorn",
    "vitest",
    "promise",
    "eslint",
    "oxc"
  ],
  "options": {
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "**/.oxlint-contract-*/**",
    "**/oxlint-contract-*",
    "tests/fixtures/**",
    "packages/*/tests/fixtures/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts"
  ]
}
